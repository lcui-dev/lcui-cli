# Generated by `lcui build` (compile) when the test runs.
# Only the input fixture files (package.json, src/hello.css) should be tracked.

.lcui/
dist/
vendor.node_modules/
node_modules/

# CSS loader emits a header file next to the source.
src/*.h
src/*.css.h

# AppPlugin emits main.c / main.h into sourceDir.
src/main.c
src/main.h
